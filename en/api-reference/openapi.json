{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Platform OpenAPI",
    "description": "Async image and video generation. Create a task, then poll task_id. Result URLs are kept about 3 days.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://aiplatform.ccwu.cc",
      "description": "AI Platform production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/images": {
      "post": {
        "summary": "Create image task",
        "description": "Create an async GPT Image 2 task.",
        "operationId": "createImage",
        "tags": [
          "Images"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageCreateRequest"
              },
              "examples": {
                "gptImage2": {
                  "summary": "gpt-image-2",
                  "value": {
                    "model": "gpt-image-2",
                    "prompt": "极简产品静物，白色背景，柔光",
                    "quality": "medium",
                    "n": 1,
                    "ratio": "1:1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/images/{taskId}": {
      "get": {
        "summary": "Query image task",
        "operationId": "getImage",
        "tags": [
          "Images"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos": {
      "post": {
        "summary": "Create video task",
        "description": "Unified video create. Available models: seedance2.0-md, seedance2.5-30s.",
        "operationId": "createVideo",
        "tags": [
          "Videos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoCreateRequest"
              },
              "examples": {
                "seedanceMd": {
                  "summary": "seedance2.0-md",
                  "value": {
                    "model": "seedance2.0-md",
                    "prompt": "城市夜景延时，车流光轨",
                    "duration": 10,
                    "aspect_ratio": "16:9"
                  }
                },
                "seedance30s": {
                  "summary": "seedance2.5-30s",
                  "value": {
                    "model": "seedance2.5-30s",
                    "prompt": "一只猫在草地上奔跑，跟拍镜头",
                    "aspect_ratio": "9:16"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos/{taskId}": {
      "get": {
        "summary": "Query video task",
        "operationId": "getVideo",
        "tags": [
          "Videos"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model/catalog": {
      "get": {
        "summary": "Model catalog",
        "description": "No auth required. Lists enabled public billing models.",
        "operationId": "modelCatalog",
        "tags": [
          "Common"
        ],
        "security": [],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "模型列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "API key from the console. Format: Bearer sk_xxx"
      }
    },
    "schemas": {
      "ImageCreateRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "gpt-image-2 或 gpt-image-2-low / medium / high",
            "example": "gpt-image-2"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "quality": {
            "type": "string",
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "default": "auto"
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "ratio": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "description": "ratio 别名"
          },
          "resolution": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 15
          }
        }
      },
      "VideoCreateRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "seedance2.0-md 或 seedance2.5-30s",
            "example": "seedance2.0-md"
          },
          "prompt": {
            "type": "string"
          },
          "duration": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "seedance2.0-md：5/10/15；seedance2.5-30s：固定 30"
          },
          "seconds": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "duration 别名"
          },
          "aspect_ratio": {
            "type": "string"
          },
          "ratio": {
            "type": "string",
            "description": "aspect_ratio 别名"
          },
          "orientation": {
            "type": "string",
            "description": "portrait/landscape 可推导比例"
          },
          "size": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_videos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "audios": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_audios": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "TaskResult": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string"
          },
          "video_url": {
            "type": "string"
          }
        }
      },
      "TaskQueryData": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "queued / processing / completed / failed 等"
          },
          "progress": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "completed_at": {
            "type": "integer"
          },
          "cost": {
            "type": "number"
          },
          "error_message": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/TaskResult"
          }
        }
      },
      "TaskQueryResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TaskQueryData"
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "properties": {
          "model_name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "model_type": {
            "type": "string"
          },
          "price_mode": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "official_price": {
            "type": "number"
          },
          "remark": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "list": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            }
          }
        }
      }
    }
  }
}