{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Platform OpenAPI",
    "description": "异步图片与视频生成。创建后轮询 task_id；结果 URL 约保留 3 天。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://sigrunai.com",
      "description": "AI Platform 生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/images": {
      "post": {
        "summary": "Create image task",
        "description": "Create an async GPT Image 2 or Nano Banana image task.",
        "operationId": "createImage",
        "tags": [
          "Images"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageCreateRequest"
              },
              "examples": {
                "gptImage2": {
                  "summary": "gpt-image-2",
                  "value": {
                    "model": "gpt-image-2",
                    "prompt": "Minimal product still life, white background, soft light",
                    "quality": "medium",
                    "n": 1,
                    "ratio": "1:1"
                  }
                },
                "nanoBanana2": {
                  "summary": "nano-banana-2",
                  "value": {
                    "model": "nano-banana-2",
                    "prompt": "Cinematic sunset over a lake, golden light on distant mountains",
                    "ratio": "16:9",
                    "resolution": "2k"
                  }
                },
                "nanoBananaPro": {
                  "summary": "nano-banana-pro",
                  "value": {
                    "model": "nano-banana-pro",
                    "prompt": "Keep the product look, switch to soft studio lighting",
                    "ratio": "1:1",
                    "resolution": "4k",
                    "images": [
                      "https://example.com/product.jpg"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/images/{taskId}": {
      "get": {
        "summary": "查询图片任务",
        "operationId": "getImage",
        "tags": [
          "Images"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos": {
      "post": {
        "summary": "Create video task",
        "description": "Unified video create entry. Available models: omni-10s, veo3.1-fast, veo3.1-lite, veo3.1-lite-hd, grok-imagine-video-1.5 (and fast/lite), minimax-h3, minimax-h3-max, kling-4.0 (720p/1080p), seedance2.0-md, sd2-480p-ac, sd2-720p-ac, seedance2.5-30s, sd2.5-720p-ac, wan3-480p-20s-ac. Veo also has POST /v1/veo/frames.",
        "operationId": "createVideo",
        "tags": [
          "Videos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoCreateRequest"
              },
              "examples": {
                "omni10s": {
                  "summary": "omni-10s",
                  "value": {
                    "model": "omni-10s",
                    "prompt": "A golden retriever running across a sunny meadow, cinematic tracking shot",
                    "aspect_ratio": "16:9"
                  }
                },
                "veo31Fast": {
                  "summary": "veo3.1-fast",
                  "value": {
                    "model": "veo3.1-fast",
                    "prompt": "A golden retriever running across a sunny meadow, cinematic tracking shot",
                    "resolution": "720p",
                    "orientation": "landscape"
                  }
                },
                "seedanceMd": {
                  "summary": "seedance2.0-md",
                  "value": {
                    "model": "seedance2.0-md",
                    "prompt": "城市夜景延时，车流光轨",
                    "duration": 10,
                    "aspect_ratio": "16:9"
                  }
                },
                "seedance30s": {
                  "summary": "seedance2.5-30s",
                  "value": {
                    "model": "seedance2.5-30s",
                    "prompt": "一只猫在草地上奔跑，跟拍镜头",
                    "aspect_ratio": "9:16"
                  }
                },
                "seedance20Ac": {
                  "summary": "sd2-720p-ac",
                  "value": {
                    "model": "sd2-720p-ac",
                    "prompt": "A cat running on grass, tracking shot",
                    "duration": 8,
                    "aspect_ratio": "9:16"
                  }
                },
                "seedance720pAc": {
                  "summary": "sd2.5-720p-ac",
                  "value": {
                    "model": "sd2.5-720p-ac",
                    "prompt": "A cat running on grass, tracking shot",
                    "duration": 8,
                    "aspect_ratio": "9:16"
                  }
                },
                "kling40": {
                  "summary": "kling-4.0",
                  "value": {
                    "model": "kling-4.0",
                    "prompt": "A golden retriever running across a sunny meadow, cinematic tracking shot",
                    "duration": 8,
                    "aspect_ratio": "16:9",
                    "resolution": "720p"
                  }
                },
                "wan3Ac": {
                  "summary": "wan3-480p-20s-ac",
                  "value": {
                    "model": "wan3-480p-20s-ac",
                    "prompt": "A cat running on grass, tracking shot",
                    "duration": 8,
                    "aspect_ratio": "16:9"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos/{taskId}": {
      "get": {
        "summary": "Query video task",
        "operationId": "getVideo",
        "tags": [
          "Videos"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/veo/frames": {
      "post": {
        "summary": "Create Veo 3.1 video",
        "description": "Dedicated Veo 3.1 Fast / Lite endpoint. Models: veo3.1-fast, veo3.1-lite, veo3.1-lite-hd. Supports text-to-video, up to 3 reference images, or first/last frames (mutually exclusive). Poll GET /v1/videos/{task_id}.",
        "operationId": "createVeoFrames",
        "tags": [
          "Videos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VeoFramesCreateRequest"
              },
              "examples": {
                "textToVideo": {
                  "summary": "Text-to-video",
                  "value": {
                    "model": "veo3.1-fast",
                    "prompt": "A golden retriever running across a sunny meadow, cinematic tracking shot",
                    "resolution": "720p",
                    "orientation": "landscape"
                  }
                },
                "referenceImages": {
                  "summary": "Reference images",
                  "value": {
                    "model": "veo3.1-fast",
                    "prompt": "Keep subject and style consistent; slow push-in",
                    "resolution": "1080p",
                    "orientation": "portrait",
                    "images": [
                      "https://example.com/ref1.jpg",
                      "https://example.com/ref2.jpg"
                    ]
                  }
                },
                "firstLastFrames": {
                  "summary": "First / last frames",
                  "value": {
                    "model": "veo3.1-lite",
                    "prompt": "Smooth push from close-up to wide shot",
                    "resolution": "720p",
                    "aspect_ratio": "16:9",
                    "first_frame_url": "https://example.com/first.jpg",
                    "last_frame_url": "https://example.com/last.jpg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/files": {
      "post": {
        "summary": "上传文件",
        "description": "multipart 上传图片/视频/音频，返回公网 url。",
        "operationId": "uploadFile",
        "tags": [
          "Common"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model/catalog": {
      "get": {
        "summary": "查询模型目录",
        "description": "无需鉴权。返回当前启用的公开计费模型。",
        "operationId": "modelCatalog",
        "tags": [
          "Common"
        ],
        "security": [],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "模型列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/user/balance": {
      "get": {
        "summary": "Get user account balance",
        "description": "Returns points balance for the account that owns the current API key.",
        "operationId": "getUserBalance",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBalanceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/key/balance": {
      "get": {
        "summary": "Get API key quota balance",
        "description": "Returns call quota for the current API key (independent of account points).",
        "operationId": "getKeyBalance",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Key quota",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyBalanceResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "控制台创建的 API Key，格式：Bearer sk_xxx"
      }
    },
    "schemas": {
      "ImageCreateRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "gpt-image-2 (plus low/medium/high) or nano-banana-2 / nano-banana-2.1 / nano-banana-pro",
            "example": "nano-banana-2"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "GPT Image 2 max 4000; Nano Banana max 10000. Optional when images are provided"
          },
          "quality": {
            "type": "string",
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "default": "auto"
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "ratio": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "description": "ratio 别名"
          },
          "resolution": {
            "type": "string",
            "description": "Nano Banana: 0.5k/1k/2k/4k depending on model"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 15,
            "description": "Reference image URLs. GPT Image 2 max 15; Nano Banana max 5"
          }
        }
      },
      "VideoCreateRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "omni-10s, veo3.1-fast, veo3.1-lite, veo3.1-lite-hd, grok-imagine-video-1.5 (and fast/lite), minimax-h3, minimax-h3-max, kling-4.0 / kling-4.0-720p / kling-4.0-1080p, seedance2.0-md, sd2-480p-ac, sd2-720p-ac, seedance2.5-30s, sd2.5-720p-ac, or wan3-480p-20s-ac",
            "example": "omni-10s"
          },
          "prompt": {
            "type": "string"
          },
          "duration": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "omni-10s: fixed 10; seedance2.0-md: 5/10/15; sd2-*-ac: 4–15; seedance2.5-30s: fixed 30; sd2.5-720p-ac: 4–30; wan3-480p-20s-ac: 5–20"
          },
          "seconds": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Alias of duration"
          },
          "aspect_ratio": {
            "type": "string"
          },
          "ratio": {
            "type": "string",
            "description": "Alias of aspect_ratio"
          },
          "orientation": {
            "type": "string",
            "description": "portrait/landscape may imply aspect ratio"
          },
          "size": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "description": "omni-10s is fixed at 720p"
          },
          "first_image": {
            "type": "string",
            "format": "uri",
            "description": "First-frame URL for omni-10s frame mode"
          },
          "last_image": {
            "type": "string",
            "format": "uri",
            "description": "Last-frame URL for omni-10s; use with first_image"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_videos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_video_durations": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "description": "Required with reference videos for kling-4.0; same length as videos; seconds 1–30. Billable seconds = output duration + sum of these values."
          },
          "reference_audio_durations": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 5,
              "maximum": 30
            },
            "description": "Required with reference audios for kling-4.0; same length as audios; seconds 5–30 (validation only, not billed)."
          },
          "audios": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_audios": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "VeoFramesCreateRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "veo3.1-fast (default), veo3.1-lite, veo3.1-lite-hd",
            "example": "veo3.1-fast"
          },
          "prompt": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "description": "720p or 1080p; 4k is not supported",
            "example": "720p"
          },
          "orientation": {
            "type": "string",
            "description": "landscape (16:9) or portrait (9:16)",
            "example": "landscape"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "16:9 or 9:16; can replace orientation"
          },
          "ratio": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 3,
            "description": "Up to 3 reference images; mutually exclusive with first/last frames"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 3
          },
          "first_frame_url": {
            "type": "string",
            "format": "uri"
          },
          "last_frame_url": {
            "type": "string",
            "format": "uri"
          },
          "first_image": {
            "type": "string",
            "format": "uri"
          },
          "last_image": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "TaskResult": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string"
          },
          "video_url": {
            "type": "string"
          }
        }
      },
      "TaskQueryData": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "queued / processing / completed / failed 等"
          },
          "progress": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "completed_at": {
            "type": "integer"
          },
          "cost": {
            "type": "number"
          },
          "error_message": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/TaskResult"
          }
        }
      },
      "FileUploadResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "name": {
                "type": "string"
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
                  "audio"
                ]
              },
              "bytes": {
                "type": "integer"
              }
            }
          }
        }
      },
      "TaskQueryResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TaskQueryData"
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "properties": {
          "model_name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "model_type": {
            "type": "string"
          },
          "price_mode": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "official_price": {
            "type": "number"
          },
          "remark": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "list": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            }
          }
        }
      },
      "UserBalanceResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "balance": {
                "type": "number"
              },
              "used_coin": {
                "type": "number"
              },
              "available": {
                "type": "number"
              }
            }
          }
        }
      },
      "KeyBalanceResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 20000
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "total_quota": {
                "type": "number"
              },
              "used_quota": {
                "type": "number"
              },
              "available_quota": {
                "type": "number"
              },
              "unlimited": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
